generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  username  String   @unique
  age       Int
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}